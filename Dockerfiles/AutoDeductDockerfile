##
# Stage 1 - Base image and packages
#
# NOTE: We start with Ubuntu instead of e.g. Alpine because
#   Frama-C under Alpine does not fully support E-ACSL.
#
FROM ubuntu:24.04 AS auto-deduct-base

ARG CERT="./Dockerfiles/cert/scania-it-tls-inspect-root.crt"
ARG CERT_LOC="/usr/local/share/ca-certificates/"

ARG PROXY_HOST=""
ARG PROXY_PORT=""

ARG FRAMA_C_VER="31.0"
ARG SAIDA_REPO="https://github.com/rse-verification/saida.git"
ARG SAIDA_VER="v0.5.0"
ARG ISP_REPO="https://github.com/rse-verification/interface-specification-propagator.git"
# The JSON missing-helper report used by the CLI was added after v0.3.1.
# Pin this to a release commit before publishing the V1 image.
ARG ISP_VER="master"
# ARG TRICERA_VER="v0.4"
# This is a workaround until TriCera gets more regular releases.
ARG TRICERA_REPO="https://github.com/uuverifiers/tricera.git"
ARG TRICERA_VER="5324b60f43e3e90314a151d056e5559a0ec3d63e"

# This is the user id of "dev" user that will be created in the container
ARG UID="2000"

# bash - used by "sbt" (Scala build tool)
# clang - used by Tricera-pp
# ca-certificates - trusted certificates management (see below)
# curl - to download coursier (Scala install tool)
# cvc4 - SMT solver for use by Frama-C
# ocaml - used by Frama-C plugins
# opam - ocaml package manager
# openjdk - used by Scala
# python3 - AutoDeduct command-line runner
# Z3 - SMT solver for use by Frama-C
# + a bunch of other libraries required by Frama-C
#
# Note: We install two different icon themes. For some reason,
#  when running GTK-applications, like Frama-C GUI, inside a
#  devcontainer in Visual Studio Code the system is using one
#  setup, and when running from a docker container directly,
#  it is using another setup. It seems to have to do with
#  Visual Studio Code setting up the XDG_RUNTIME_DIR environment
#  variable and therefore getting a different set of dconf
#  settings.
RUN apt-get update && \
  apt-get install \
    adwaita-icon-theme-full \
    autoconf \
    ca-certificates \
    curl \
    cvc4 \
    git \
    graphviz \
    libcairo2-dev \
    libexpat1-dev \
    libgmp-dev \
    libgtk-3-dev \
    libgtksourceview-3.0-dev \
    pkg-config \
    zlib1g-dev \
    ocaml \
    opam \
    openjdk-21-jdk \
    python3 \
    sudo \
    vim \
    yaru-theme-icon \
    z3 \
    --yes

# Scania has implemented TLS inspection/scanning (replacing certificates)
# in the proxy. Therefore we need the scania root certificate among the
# trusted root certificates. Otherwise, tools like curl won't work when
# we are behind the proxy.
COPY ${CERT} ${CERT_LOC}

RUN update-ca-certificates && \
  keytool \
  -import \
  -noprompt \
  -trustcacerts \
  -alias ScaniaItTlsInspectRoot \
  -file "${CERT_LOC}scania-it-tls-inspect-root.crt" \
  -storepass changeit \
  -cacerts

# Set up a new user in the container
RUN  adduser --disabled-password --shell /usr/bin/bash --uid ${UID} --gecos "Development user" dev && \
  echo "dev:dev" | chpasswd && \
  usermod -aG sudo dev && \
  mkdir -p /home/dev/repos /home/dev/.local/bin && \
  chown -R dev:dev /home/dev

USER dev
WORKDIR /home/dev

# Create later work directories as the unprivileged build user. Docker-created
# WORKDIR paths can otherwise be root-owned on some builders.
RUN mkdir -p /home/dev/repos /home/dev/.local/bin

# Fix "less" charset settings.
RUN echo "export LESSCHARSET=utf-8" >> .profile

# Fix git propmt and add bash autocompletion for git commands
RUN . /home/dev/.profile && \
  echo ". /etc/bash_completion.d/git-prompt" >> .bashrc && \
  echo ". /usr/share/bash-completion/completions/git" >> .bashrc && \
  cat >> /home/dev/.bashrc <<EOF
if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
    # We have color support; assume it's compliant with Ecma-48
    # (ISO/IEC-6429). (Lack of such support is extremely rare, and such
    # a case would tend to support setf rather than setaf.)
    PROMPT_COMMAND='__git_ps1 "${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00;35m\]" "\[\033[00m\]\$ "'
else
    PROMPT_COMMAND='__git_ps1 "${debian_chroot:+($debian_chroot)}\u@\h:\w" "\$ "'
fi
EOF

##
# Stage 2 - Add Frama-C related stuff
#
FROM auto-deduct-base AS auto-deduct-frama-c

ARG FRAMA_C_VER="31.0"

USER dev
WORKDIR /home/dev

RUN : "${FRAMA_C_VER:?FRAMA_C_VER must not be empty}" && \
  opam init --disable-sandboxing --yes && \
  opam init --shell-setup && \
  opam install "frama-c.${FRAMA_C_VER}" --yes && \
  opam install ocaml-lsp-server --yes && \
  opam install ocamlformat --yes && \
  opam clean && \
  eval $(opam env)

# Add Frama-C auto-completion for bash
RUN . /home/dev/.profile && \
  mkdir -p /home/dev/.local/share/bash-completion/completions && \
  cp $(frama-c-config -print-share-path)/autocomplete_frama-c /home/dev/.local/share/bash-completion/completions/frama-c && \
  echo ". /home/dev/.local/share/bash-completion/completions/frama-c" >> /home/dev/.bashrc

##
# Stage 3 - Add Scala related stuff
#
FROM auto-deduct-frama-c AS auto-deduct-scala

ARG PROXY_HOST=""
ARG PROXY_PORT=""

USER dev
WORKDIR /home/dev

# NOTE: For some reason JAVA needs to be told that it is working
#   behind a proxy.
RUN curl -fLo coursierLauncher https://github.com/coursier/launchers/raw/master/coursier && \
  if [ "${PROXY_HOST}" != "" -a "${PROXY_PORT}" != "" ]; then \
    java -Dhttps.proxyHost=${PROXY_HOST} -Dhttps.proxyPort=${PROXY_PORT} -jar coursierLauncher setup --yes; \
  else \
    java -jar coursierLauncher setup --yes; \
  fi && \
  rm coursierLauncher


##
# Stage 4 - Add TriCera codebase and compile
# 
# NOTE: We change the version of sbt build properties in order
#   avoid a deprecation error. 
#  (java.lang.UnsupportedOperationException: The Security Manager
#   is deprecated and will be removed in a future release)
#
FROM auto-deduct-scala AS auto-deduct-tricera

ARG TRICERA_VER="5324b60f43e3e90314a151d056e5559a0ec3d63e"

USER dev
WORKDIR /home/dev/repos

RUN : "${TRICERA_REPO:?TRICERA_REPO must not be empty}" && \
  : "${TRICERA_VER:?TRICERA_VER must not be empty}" && \
  . /home/dev/.profile && \
  git clone --depth 1 --no-checkout "${TRICERA_REPO}" tricera && \
  cd tricera && \
  git fetch --depth 1 origin "${TRICERA_VER}" && \
  git checkout --detach FETCH_HEAD && \
  git rev-parse HEAD > REVISION && \
  sed -i -e "s/1.4.0/1.9.8/" project/build.properties && \
  sbt assembly

WORKDIR /home/dev/.local/bin
RUN ln -s /home/dev/repos/tricera/tri && \
  ln -s /home/dev/repos/tricera/tri-pp && \
  ln -s /home/dev/repos/tricera/tri-client

##
# Stage 5 - Add AutoDeduct Frama-C plugins and CLI
#
# The V1 image packages the command-line pipeline only. GUI and LLM helpers
# are intentionally outside this release profile.
#
FROM auto-deduct-tricera AS auto-deduct-toolchain

ARG SAIDA_VER="v0.5.0"
ARG ISP_VER="v0.3.1"

USER dev
WORKDIR /home/dev/repos

RUN : "${SAIDA_REPO:?SAIDA_REPO must not be empty}" && \
  : "${SAIDA_VER:?SAIDA_VER must not be empty}" && \
  . /home/dev/.profile && \
  git clone --depth 1 --no-checkout "${SAIDA_REPO}" saida && \
  cd saida && \
  git fetch --depth 1 origin "${SAIDA_VER}" && \
  git checkout --detach FETCH_HEAD && \
  git rev-parse HEAD > REVISION && \
  dune build @install && \
  dune install && \
  why3 config detect

RUN : "${ISP_REPO:?ISP_REPO must not be empty}" && \
  : "${ISP_VER:?ISP_VER must not be empty}" && \
  . /home/dev/.profile && \
  git clone --depth 1 --no-checkout "${ISP_REPO}" interface-specification-propagator && \
  cd interface-specification-propagator && \
  git fetch --depth 1 origin "${ISP_VER}" && \
  git checkout --detach FETCH_HEAD && \
  git rev-parse HEAD > REVISION && \
  dune build @install && \
  dune install

RUN . /home/dev/.profile && \
  git clone --depth 1 https://github.com/rse-verification/auto-deduct-examples.git

# Install the command as `autodeduct` on the system PATH, including for
# non-interactive `docker run IMAGE autodeduct ...` invocations.
COPY --chmod=0755 bin/autodeduct /usr/local/bin/autodeduct
COPY --chmod=0755 bin/autodeduct_pipeline.py /usr/local/bin/autodeduct_pipeline.py

# Non-interactive `docker run IMAGE autodeduct ...` does not source .profile.
ENV PATH="/home/dev/.local/bin:/home/dev/.opam/default/bin:${PATH}"

WORKDIR /home/dev

CMD ["/usr/bin/bash", "-l"]
