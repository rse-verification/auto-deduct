##
# Stage 1 - Base image and packages
#
# NOTE: We start with Ubuntu instead of e.g. Alpine because
#   Frama-C under Alpine does not fully support E-ACSL.
#
FROM ubuntu:24.04 AS auto-deduct-base

ARG CERT="./Dockerfiles/cert/scania-it-tls-inspect-root.crt"
ARG CERT_LOC="/usr/local/share/ca-certificates/"

ARG PROXY_HOST=""
ARG PROXY_PORT=""

ARG FRAMA_C_VER="33.0"
ARG OCAML_VER="5.4.0"
ARG SAIDA_REPO="https://github.com/rse-verification/saida.git"
# Saida v0.6.0; pin the commit so rebuilding does not follow a moved tag.
ARG SAIDA_VER="605a4a4ae976050ec5e1060fec621ef4d6157f68"
ARG ISP_REPO="https://github.com/rse-verification/interface-specification-propagator.git"
# ISP v0.4.0 contains the Frama-C 33 compatibility and CDL-2651 fixes.
ARG ISP_VER="v0.4.0"
ARG TRICERA_REPO="https://github.com/uuverifiers/tricera.git"
ARG TRICERA_VER="v0.5"

# This is the user id of "dev" user that will be created in the container
ARG UID="2000"

# bash - used by "sbt" (Scala build tool)
# clang - used by Tricera-pp
# ca-certificates - trusted certificates management (see below)
# curl - to download coursier (Scala install tool)
# cvc4 - SMT solver for use by Frama-C
# ocaml - bootstrap compiler used to install the pinned opam compiler
# opam - ocaml package manager
# openjdk - used by Scala
# python3 - AutoDeduct command-line runner
# Z3 - SMT solver for use by Frama-C
# + a bunch of other libraries required by Frama-C
#
# The remaining development libraries and icon themes are Frama-C build
# dependencies retained from the base toolchain image.
RUN apt-get update && \
  apt-get install \
    adwaita-icon-theme-full \
    autoconf \
    ca-certificates \
    curl \
    cvc4 \
    git \
    graphviz \
    libcairo2-dev \
    libexpat1-dev \
    libgmp-dev \
    libgtk-3-dev \
    libgtksourceview-3.0-dev \
    pkg-config \
    zlib1g-dev \
    ocaml \
    opam \
    openjdk-21-jdk \
    python3 \
    sudo \
    vim \
    yaru-theme-icon \
    z3 \
    --yes

# Scania has implemented TLS inspection/scanning (replacing certificates)
# in the proxy. Therefore we need the scania root certificate among the
# trusted root certificates. Otherwise, tools like curl won't work when
# we are behind the proxy.
COPY ${CERT} ${CERT_LOC}

RUN update-ca-certificates && \
  keytool \
  -import \
  -noprompt \
  -trustcacerts \
  -alias ScaniaItTlsInspectRoot \
  -file "${CERT_LOC}scania-it-tls-inspect-root.crt" \
  -storepass changeit \
  -cacerts

# Set up a new user in the container
RUN  adduser --disabled-password --shell /usr/bin/bash --uid ${UID} --gecos "Development user" dev && \
  echo "dev:dev" | chpasswd && \
  usermod -aG sudo dev && \
  mkdir -p /home/dev/repos /home/dev/.local/bin && \
  chown -R dev:dev /home/dev

USER dev
WORKDIR /home/dev

# Create later work directories as the unprivileged build user. Docker-created
# WORKDIR paths can otherwise be root-owned on some builders.
RUN mkdir -p /home/dev/repos /home/dev/.local/bin

# Fix "less" charset settings.
RUN echo "export LESSCHARSET=utf-8" >> .profile

# Fix git propmt and add bash autocompletion for git commands
RUN . /home/dev/.profile && \
  echo ". /etc/bash_completion.d/git-prompt" >> .bashrc && \
  echo ". /usr/share/bash-completion/completions/git" >> .bashrc && \
  cat >> /home/dev/.bashrc <<EOF
if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
    # We have color support; assume it's compliant with Ecma-48
    # (ISO/IEC-6429). (Lack of such support is extremely rare, and such
    # a case would tend to support setf rather than setaf.)
    PROMPT_COMMAND='__git_ps1 "${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00;35m\]" "\[\033[00m\]\$ "'
else
    PROMPT_COMMAND='__git_ps1 "${debian_chroot:+($debian_chroot)}\u@\h:\w" "\$ "'
fi
EOF

##
# Stage 2 - Add Frama-C related stuff
#
FROM auto-deduct-base AS auto-deduct-frama-c

# Import the top-level values so the selected toolchain versions reach opam.
ARG FRAMA_C_VER
ARG OCAML_VER

USER dev
WORKDIR /home/dev

RUN : "${FRAMA_C_VER:?FRAMA_C_VER must not be empty}" && \
  : "${OCAML_VER:?OCAML_VER must not be empty}" && \
  opam init --bare --disable-sandboxing --yes && \
  opam switch create default "ocaml-base-compiler.${OCAML_VER}" --yes && \
  eval "$(opam env --switch=default --set-switch)" && \
  opam install "frama-c.${FRAMA_C_VER}" --yes && \
  opam install ocaml-lsp-server --yes && \
  opam install ocamlformat --yes && \
  opam env --switch=default --set-switch >> /home/dev/.profile && \
  opam clean && \
  ocamlc -version

# Add Frama-C auto-completion for bash
RUN . /home/dev/.profile && \
  mkdir -p /home/dev/.local/share/bash-completion/completions && \
  cp $(frama-c-config -print-share-path)/autocomplete_frama-c /home/dev/.local/share/bash-completion/completions/frama-c && \
  echo ". /home/dev/.local/share/bash-completion/completions/frama-c" >> /home/dev/.bashrc

##
# Stage 3 - Add Scala related stuff
#
FROM auto-deduct-frama-c AS auto-deduct-scala

ARG PROXY_HOST=""
ARG PROXY_PORT=""
ARG COURSIER_VER="v2.1.24"

USER dev
WORKDIR /home/dev

# NOTE: For some reason JAVA needs to be told that it is working
#   behind a proxy.
RUN curl -fLo coursierLauncher "https://github.com/coursier/coursier/releases/download/${COURSIER_VER}/coursier" && \
  if [ "${PROXY_HOST}" != "" -a "${PROXY_PORT}" != "" ]; then \
    java -Dhttps.proxyHost=${PROXY_HOST} -Dhttps.proxyPort=${PROXY_PORT} -jar coursierLauncher setup --yes; \
  else \
    java -jar coursierLauncher setup --yes; \
  fi && \
  rm coursierLauncher


##
# Stage 4 - Add TriCera codebase and compile
# 
# NOTE: We change the version of sbt build properties in order
#   avoid a deprecation error. 
#  (java.lang.UnsupportedOperationException: The Security Manager
#   is deprecated and will be removed in a future release)
#
FROM auto-deduct-scala AS auto-deduct-tricera

# Import the top-level TriCera ref selected for this image.
ARG TRICERA_VER

USER dev
WORKDIR /home/dev/repos

RUN : "${TRICERA_REPO:?TRICERA_REPO must not be empty}" && \
  : "${TRICERA_VER:?TRICERA_VER must not be empty}" && \
  . /home/dev/.profile && \
  git clone --depth 1 --no-checkout "${TRICERA_REPO}" tricera && \
  cd tricera && \
  git fetch --depth 1 origin "${TRICERA_VER}" && \
  git checkout --detach FETCH_HEAD && \
  git rev-parse HEAD > REVISION && \
  sed -i -e "s/1.4.0/1.9.8/" project/build.properties && \
  sbt assembly

WORKDIR /home/dev/.local/bin
RUN ln -s /home/dev/repos/tricera/tri && \
  ln -s /home/dev/repos/tricera/tri-pp && \
  ln -s /home/dev/repos/tricera/tri-client

##
# Stage 5 - Add AutoDeduct Frama-C plugins and CLI
#
# The CLI selects the deductive or LLM workflow at runtime.
#
FROM auto-deduct-tricera AS auto-deduct-runtime

# Import the top-level Saida ref selected for this image.
ARG SAIDA_VER
# Import the top-level value instead of redeclaring a stage-specific default.
# The CLI requires ISP v0.4.0 or newer for its machine-readable helper report.
ARG ISP_VER

USER dev
WORKDIR /home/dev/repos

RUN : "${SAIDA_REPO:?SAIDA_REPO must not be empty}" && \
  : "${SAIDA_VER:?SAIDA_VER must not be empty}" && \
  . /home/dev/.profile && \
  git clone --depth 1 --no-checkout "${SAIDA_REPO}" saida && \
  cd saida && \
  git fetch --depth 1 origin "${SAIDA_VER}" && \
  git checkout --detach FETCH_HEAD && \
  git rev-parse HEAD > REVISION && \
  dune build @install && \
  dune install && \
  why3 config detect

RUN : "${ISP_REPO:?ISP_REPO must not be empty}" && \
  : "${ISP_VER:?ISP_VER must not be empty}" && \
  . /home/dev/.profile && \
  git clone --depth 1 --no-checkout "${ISP_REPO}" interface-specification-propagator && \
  cd interface-specification-propagator && \
  git fetch --depth 1 origin "${ISP_VER}" && \
  git checkout --detach FETCH_HEAD && \
  git rev-parse HEAD > REVISION && \
  dune build @install && \
  dune install

# Install the command as `autodeduct` on the system PATH, including for
# non-interactive `docker run IMAGE autodeduct ...` invocations.
COPY --chmod=0755 bin/autodeduct /usr/local/bin/autodeduct
COPY --chmod=0755 bin/autodeduct_pipeline /usr/local/bin/autodeduct_pipeline

# Non-interactive `docker run IMAGE autodeduct ...` does not source .profile.
ENV PATH="/home/dev/.local/bin:/home/dev/.opam/default/bin:${PATH}"

WORKDIR /home/dev

CMD ["/usr/bin/bash", "-l"]

##
# Build AcTa against its supported Frama-C without downgrading the main switch.
# Ubuntu's system OCaml is sufficient for this separate frontend.
#
FROM auto-deduct-base AS auto-deduct-acta

ARG ACTA_REPO="https://github.com/rse-verification/AcTa.git"
ARG ACTA_VER="74ef7de3f676efbdd7e1b8932e03b018fd449dc0"
ARG ACTA_FRAMA_C_VER="31.0"

USER dev
WORKDIR /home/dev/repos
RUN opam init --bare --disable-sandboxing --yes && \
  opam switch create acta ocaml-system --yes && \
  eval "$(opam env --switch=acta --set-switch)" && \
  opam install "frama-c.${ACTA_FRAMA_C_VER}" --yes

COPY --chmod=0755 Dockerfiles/github-askpass /tmp/github-askpass
RUN --mount=type=secret,id=github_token,mode=0444 \
  : "${ACTA_REPO:?ACTA_REPO must not be empty}" && \
  : "${ACTA_VER:?ACTA_VER must not be empty}" && \
  eval "$(opam env --switch=acta --set-switch)" && \
  if [ -s /run/secrets/github_token ]; then export GIT_ASKPASS=/tmp/github-askpass; fi && \
  GIT_TERMINAL_PROMPT=0 git clone --depth 1 --no-checkout "${ACTA_REPO}" acta && \
  cd acta && \
  GIT_TERMINAL_PROMPT=0 git fetch --depth 1 origin "${ACTA_VER}" && \
  git checkout --detach FETCH_HEAD && \
  git rev-parse HEAD > REVISION

RUN eval "$(opam env --switch=acta --set-switch)" && \
  cd /home/dev/repos/acta && \
  dune build @install && \
  dune install && \
  frama-c -acta-help && \
  opam clean --all-switches --logs --download-cache --yes

##
# Stage 6 - Add LOGOS to the standard toolchain
#
FROM auto-deduct-runtime AS auto-deduct-logos

ARG LOGOS_REPO="https://github.com/rse-verification/logos.git"
ARG LOGOS_VER="cea177911b6ad5176122b4b3c415f92897c464d2"
LABEL org.opencontainers.image.logos.source="${LOGOS_REPO}" \
      org.opencontainers.image.logos.revision="${LOGOS_VER}"

USER root
RUN apt-get update && \
  apt-get install --yes --no-install-recommends libclang-dev && \
  rm -rf /var/lib/apt/lists/* && \
  chmod o+rx /home/dev

# Retain the skill and resolved revision, without a source checkout or Git history.
RUN : "${LOGOS_REPO:?LOGOS_REPO must not be empty}" && \
  : "${LOGOS_VER:?LOGOS_VER must not be empty}" && \
  GIT_TERMINAL_PROMPT=0 git clone --depth 1 --no-checkout "${LOGOS_REPO}" /tmp/logos && \
  git -C /tmp/logos fetch --depth 1 origin "${LOGOS_VER}" && \
  git -C /tmp/logos checkout --detach FETCH_HEAD && \
  mkdir -p /opt/logos && \
  cp -a /tmp/logos/skill /opt/logos/skill && \
  git -C /tmp/logos rev-parse HEAD > /opt/logos/REVISION && \
  rm -rf /tmp/logos

ENV AUTODEDUCT_LLM_SKILL=/opt/logos/skill/SKILL.md
ENV AUTODEDUCT_CONTAINER=1
# The host UID may have no passwd entry; keep Why3's configured prover location.
ENV HOME=/home/dev

USER dev
RUN PYTHONPATH=/opt/logos/skill/scripts python3 -c \
      'from acsl_tool.parser import extract_functions; assert extract_functions("static inline int helper(void) { return 1; }")[0].name == "helper"' && \
    python3 /opt/logos/skill/scripts/generate_acsl.py --check-dependencies

WORKDIR /home/dev

##
# Optional AcTa/CBMC image. AcTa repository access is needed only for this target.
# Select with --target auto-deduct-acta-runtime.
#
FROM auto-deduct-logos AS auto-deduct-acta-runtime

ARG CBMC_VER="6.11.0"
ARG CBMC_SHA256_AMD64="b3721aa541038384d7801ea3aeabbcddc3e8845ac8f1cbff637cf8dec7481ac8"
ARG CBMC_SHA256_ARM64="9eb8f41a7dcda8eac6338b8367d77831431f767691e4535209925bd85e315ae7"
LABEL org.opencontainers.image.cbmc.version="${CBMC_VER}"

USER root
# Install the official package with a pinned digest for each supported platform.
RUN case "$(dpkg --print-architecture)" in \
    amd64) package="ubuntu-24.04-cbmc-${CBMC_VER}-Linux.deb"; checksum="${CBMC_SHA256_AMD64}" ;; \
    arm64) package="ubuntu-24.04-arm64-cbmc-${CBMC_VER}-Linux.deb"; checksum="${CBMC_SHA256_ARM64}" ;; \
    *) echo "No pinned CBMC package for this architecture" >&2; exit 1 ;; \
  esac && \
  curl --fail --location --retry 3 -o /tmp/cbmc.deb \
    "https://github.com/diffblue/cbmc/releases/download/cbmc-${CBMC_VER}/${package}" && \
  echo "${checksum}  /tmp/cbmc.deb" | sha256sum --check --strict && \
  apt-get update && \
  apt-get install --yes --no-install-recommends /tmp/cbmc.deb gcc && \
  rm -rf /tmp/cbmc.deb /var/lib/apt/lists/*

COPY --from=auto-deduct-acta --chown=dev:dev /home/dev/.opam/acta /home/dev/.opam/acta
COPY --from=auto-deduct-acta /home/dev/repos/acta/REVISION /opt/acta/REVISION
COPY --from=auto-deduct-acta /home/dev/repos/acta/LICENSE /opt/acta/LICENSE
COPY --chmod=0755 bin/acta-frama-c /usr/local/bin/acta-frama-c
ENV AUTODEDUCT_ACTA_FRAMA_C=acta-frama-c

USER dev
RUN cbmc --version && acta-frama-c -acta-help

# Keep the default public build independent of private AcTa repository access.
FROM auto-deduct-logos AS auto-deduct
