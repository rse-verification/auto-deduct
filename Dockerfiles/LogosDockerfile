# syntax=docker/dockerfile:1

# Build the standard toolchain first, then supply a local LOGOS checkout:
# docker build --build-context logos=../logos -f Dockerfiles/LogosDockerfile -t auto-deduct:logos .
ARG AUTODEDUCT_IMAGE=auto-deduct:latest
FROM ${AUTODEDUCT_IMAGE}

USER root
ARG CODEX_VERSION=0.130.0
ARG LOGOS_REV=local-checkout
LABEL org.opencontainers.image.logos.source="https://github.com/rse-verification/logos" \
      org.opencontainers.image.logos.revision="${LOGOS_REV}"

RUN apt-get update && \
    apt-get install --yes --no-install-recommends libclang-dev nodejs npm && \
    npm install --global "@openai/codex@${CODEX_VERSION}" && \
    rm -rf /var/lib/apt/lists/*

# Only the runtime skill is copied; Git credentials and repository history stay on the host.
COPY --from=logos /skill /opt/logos/skill
COPY --chmod=0755 bin/autodeduct /usr/local/bin/autodeduct
COPY --chmod=0755 bin/autodeduct_pipeline /usr/local/bin/autodeduct_pipeline
ENV AUTODEDUCT_LLM_SKILL=/opt/logos/skill/SKILL.md

USER dev
RUN mkdir -p /home/dev/.codex && \
    PYTHONPATH=/opt/logos/skill/scripts python3 -c \
      'from acsl_tool.parser import extract_functions; assert extract_functions("static inline int helper(void) { return 1; }")[0].name == "helper"' && \
    python3 /opt/logos/skill/scripts/generate_acsl.py --help | grep -- --verification-json && \
    codex --version

WORKDIR /home/dev
